#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

// レイヤー定義（Vim-like モーダルシステム）

#define NORMAL_MAC   0   // Normal Mode - Mac (デフォルト)
#define NORMAL_WIN   1   // Normal Mode - Windows
#define NORMAL_IPAD  2   // Normal Mode - iPad
#define INSERT_MAC   3   // Insert Mode - Mac
#define INSERT_WIN   4   // Insert Mode - Windows
#define INSERT_IPAD  5   // Insert Mode - iPad
#define LOWER        6   // 数字/記号 (Insert専用)
#define RAISE        7   // 記号/ナビ (Insert専用)
#define SCROLL       8   // スクロールモード
#define CONTROL      9   // BT/システム
#define BASE_GAME   10   // ゲーム用（兼業キーなし）

// layer-tapの設定（素早く切り替え、離した時に認識）

&lt {
    tapping-term-ms = <200>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&none>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&none>;
        };

        // ホームロウモッド用（高速タイピング中の誤発動防止設定）
        // - balanced: タップとホールドのバランスが取れる
        // - require-prior-idle-ms: タイピング中は修飾キー発動しない
        // - hold-trigger-on-release: キーを離した時に判定（誤発動防止）

        HRM: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            display-name = "HRM";
        };

        // 通常の修飾キー用（親指・端のキー向け、標準的な反応速度）

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

/ {
    macros {
        input_userid: input_userid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8>;
            label = "INPUT_USERID";
        };

        input_email_proton: input_email_proton {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8 &kp AT &kp P &kp R &kp O &kp T &kp O &kp N &kp DOT &kp M &kp E>;
            label = "INPUT_EMAIL_PROTON";
        };

        // BT接続 + ベースレイヤー切り替えマクロ

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to NORMAL_MAC>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to NORMAL_WIN>;
            label = "BT_WIN";
        };

        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to NORMAL_IPAD>;
            label = "BT_IPAD";
        };

        // ゲームモード切り替えマクロ

        to_game: to_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to BASE_GAME>;
            label = "TO_GAME";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ==================== NORMAL MODE LAYERS ====================
        // デフォルトモード: ナビゲーション、マウス操作
        // hjkl = カーソル移動、親指クラスタ = マウスクリック

        // ========== Normal Mode - Mac (BT0) ==========

        normal_mac_layer {
            display-name = "Norm-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LG(GRAVE)            &none       &none  &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none            &none     &none   &none      &none                            &none
&kp F19                  &kp Q       &kp W  &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y            &kp U     &to INSERT_MAC  &kp O  &kp P                            &kp RBKT
&kp LCTRL                &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_GUI) F    &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp LEFT         &kp DOWN  &kp UP  &kp RIGHT  &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT     &kp Z       &kp X  &kp C            &kp V                  &mkp MB5             &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &mkp MB4         &kp M     &kp COMMA  &kp DOT  &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2        &kp C_MUTE         &mo CONTROL      &mkp LCLK              &mkp MCLK            &mo SCROLL                                                                       &kp BSPC                &mkp RCLK                                                                     &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ========== Normal Mode - Windows (BT1) ==========

        normal_win_layer {
            display-name = "Norm-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none                &none       &none                    &none            &none                  &none                                     &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none             &none                 &none             &none                     &none                                &none
&kp F19              &kp Q       &kp W                    &kp E            &kp R                  &kp T                                     &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y             &kp U                 &to INSERT_WIN    &kp O                     &kp P                                &kp RBKT
&kp LGUI             &kp A       &HRM LS(LEFT_CONTROL) S  &HRM LEFT_ALT D  &HRM LEFT_CONTROL F    &HRM LEFT_GUI G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp LEFT          &kp DOWN              &kp UP            &kp RIGHT                 &HRM RS(RA(RC(RIGHT_CONTROL))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT &kp Z       &kp X                    &kp C            &kp V                  &mkp MB5         &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &mkp MB4          &kp M                 &kp COMMA         &kp DOT                   &kp FSLH                             &HRM RIGHT_SHIFT RIGHT
&SandS LCTL LANG2    &kp C_MUTE                           &mo CONTROL      &mkp LCLK              &mkp MCLK        &mo SCROLL                                                                       &kp BSPC                &mkp RCLK                                                                                                                  &SandS RA(RIGHT_CONTROL) LANG1
            >;
        };

        // ========== Normal Mode - iPad (BT2) ==========

        normal_ipad_layer {
            display-name = "Norm-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none                    &none       &none                &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none                 &none             &none             &none                 &none                            &none
&kp F19                  &kp Q       &kp W                &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y                 &kp U             &to INSERT_IPAD   &kp O                 &kp P                            &kp RBKT
&kp LCTRL                &kp A       &HRM LS(LEFT_GUI) S  &HRM LEFT_ALT D  &HRM LEFT_GUI F        &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp LEFT              &kp DOWN          &kp UP            &kp RIGHT             &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT     &kp Z       &kp X                &kp C            &kp V                  &mkp MB5             &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &mkp MB4              &kp M             &kp COMMA         &kp DOT               &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2        &kp C_MUTE                       &mo CONTROL      &mkp LCLK              &mkp MCLK            &mo SCROLL                                                                       &kp BSPC                &mkp RCLK                                                                                                      &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ==================== INSERT MODE LAYERS ====================
        // タイピングモード: 現在のベースレイヤーとほぼ同じ
        // ESC位置でNormalに戻る、LOWER/RAISEアクセス可能

        // ========== Insert Mode - Mac (BT0) ==========

        insert_mac_layer {
            display-name = "Ins-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LG(GRAVE)            &none       &none  &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none            &none  &none      &none    &none                            &none
&kp F19                  &kp Q       &kp W  &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y            &kp U  &kp I      &kp O    &kp P                            &kp ESC
&to NORMAL_MAC           &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_GUI) F    &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp H            &kp J  &kp K      &kp L    &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT     &kp Z       &kp X  &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N            &kp M  &kp COMMA  &kp DOT  &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2        &kp C_MUTE         &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE      &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                              &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ========== Insert Mode - Windows (BT1) ==========

        insert_win_layer {
            display-name = "Ins-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none                &none       &none                    &none            &none                  &none                                     &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none             &none                 &none             &none                     &none                                &none
&kp F19              &kp Q       &kp W                    &kp E            &kp R                  &kp T                                     &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y             &kp U                 &kp I             &kp O                     &kp P                                &kp ESC
&to NORMAL_WIN       &kp A       &HRM LS(LEFT_CONTROL) S  &HRM LEFT_ALT D  &HRM LEFT_CONTROL F    &HRM LEFT_GUI G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &HRM RIGHT_GUI H  &HRM RIGHT_CONTROL J  &HRM RIGHT_ALT K  &HRM RS(RIGHT_CONTROL) L  &HRM RS(RA(RC(RIGHT_CONTROL))) SEMI  &kp MINUS
&kp LEFT             &kp Z       &kp X                    &kp C            &kp V                  &kp B            &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N             &kp M                 &kp COMMA         &kp DOT                   &kp FSLH                             &kp RIGHT
&SandS LCTL LANG2    &kp C_MUTE                           &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE  &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                                                                          &SandS RA(RIGHT_CONTROL) LANG1
            >;
        };

        // ========== Insert Mode - iPad (BT2) ==========

        insert_ipad_layer {
            display-name = "Ins-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none                    &none       &none                &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none                 &none             &none             &none                 &none                            &none
&kp F19                  &kp Q       &kp W                &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y                 &kp U             &kp I             &kp O                 &kp P                            &kp ESC
&to NORMAL_IPAD          &kp A       &HRM LS(LEFT_GUI) S  &HRM LEFT_ALT D  &HRM LEFT_GUI F        &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &HRM RIGHT_CONTROL H  &HRM RIGHT_GUI J  &HRM RIGHT_ALT K  &HRM RS(RIGHT_GUI) L  &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&kp LEFT                 &kp Z       &kp X                &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N                 &kp M             &kp COMMA         &kp DOT               &kp FSLH                         &kp RIGHT
&SandS LGUI LANG2        &kp C_MUTE                       &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE      &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                                                                  &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ==================== FUNCTION LAYERS ====================

        // ========== Lower Layer (Insert専用) ==========

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans    &trans     &trans
&trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS  &kp PRCNT  &trans
&kp CARET  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5   &trans    &trans  &trans  &trans  &trans    &trans  &kp N6    &kp N7     &kp N8    &kp N9    &kp N0     &trans
&kp PG_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans    &trans  &trans  &trans  &trans    &trans  &kp F11   &kp F12    &trans    &trans    &kp DLLR   &trans
&trans     &trans          &trans  &trans  &trans   &trans                                      &trans  &trans                                              &none
            >;
        };

        // ========== Raise Layer (Insert専用) ==========

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans     &trans     &trans     &trans    &trans    &trans               &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans     &trans     &trans
&trans     &kp QMARK  &kp EXCL   &kp AMPS  &kp PIPE  &kp BSLH             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS   &kp PRCNT  &trans
&kp CARET  &kp POUND  &kp GRAVE  &kp DQT   &kp SQT   &kp TILDE  &trans    &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &kp COLON  &trans
&trans     &kp AT     &kp LT     &kp LBRC  &kp LBKT  &kp LPAR   &trans    &trans  &trans  &trans  &trans    &trans  &kp RPAR  &kp RBKT   &kp RBRC  &kp GT     &kp DLLR   &trans
&trans     &trans                &trans    &trans    &trans     &trans                                      &trans  &trans                                               &trans
            >;
        };

        // ========== Scroll Layer (Normal時にトラックボールでスクロール) ==========

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;
        };

        // ========== Control Layer (BT/システム) ==========

        control_layer {
            display-name = "Ctrl";
            bindings = <
&trans       &trans         &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans            &trans          &trans               &trans        &trans           &trans  &trans
&kp C_SLEEP  &kp LG(MINUS)  &kp LG(PLUS)  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                    &trans  &trans  &trans  &trans            &trans          &trans               &trans        &trans           &trans  &trans
&trans       &bt_mac        &bt_win       &bt_ipad      &to_game      &bt BT_SEL 4  &bt BT_CLR        &trans  &trans  &trans  &trans    &trans  &none           &none                &none         &none            &trans  &trans
&trans       &trans         &out OUT_USB  &out OUT_TOG  &out OUT_BLE  &trans        &bt BT_CLR_ALL    &trans  &trans  &trans  &trans    &trans  &input_userid   &input_email_proton  &trans        &trans           &trans  &trans
&trans       &trans                       &trans        &trans        &trans        &trans                                              &trans  &trans                                                                      &trans
            >;
        };

        // ========== Game Layer (兼業キーなし) ==========

        base_game_layer {
            display-name = "Game";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp N1                 &kp N2      &kp N3  &kp N4       &kp N5  &kp N6                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none  &none      &none    &none     &none
&kp TAB                &kp Q       &kp W   &kp E        &kp R   &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &kp Y      &kp U  &kp I      &kp O    &kp P     &kp RBKT
&kp ESC                &kp A       &kp S   &kp D        &kp F   &kp G      &kp LEFT_CONTROL    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp RIGHT_SHIFT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp MINUS
&kp LEFT_SHIFT         &kp Z       &kp X   &kp C        &kp V   &kp B      &kp LEFT_ALT        &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP           &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT
&SandS LEFT_GUI LANG2  &kp C_MUTE          &mo CONTROL  &mo RAISE  &kp SPACE  &mo LOWER                                                                &kp BSPC         &kp ENTER                                       &kp LANG1
            >;
        };

        // Extra layer can be added in ZMK STUDIO
    };
};
