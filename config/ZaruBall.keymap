#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ZMK Studio unlock behavior

&studio_unlock {
};

// レイヤー定義

#define MAIN_MAC     0   // Main - Mac (デフォルト)
#define MAIN_WIN     1   // Main - Windows
#define MAIN_IPAD    2   // Main - iPad
#define LOWER        3   // 数字/記号
#define RAISE        4   // 記号/ナビ
#define MOUSE_MAC    5   // マウス操作 - Mac
#define MOUSE_WIN    6   // マウス操作 - Windows
#define MOUSE_IPAD   7   // マウス操作 - iPad
#define SCROLL       8   // スクロールモード
#define CONTROL      9   // BT/システム
#define BASE_GAME   10   // ゲーム用（兼業キーなし）

// layer-tapの設定（素早く切り替え、離した時に認識）

&lt {
    tapping-term-ms = <200>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&none>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&none>;
        };

        // ホームロウモッド用（高速タイピング中の誤発動防止設定）
        // - balanced: タップとホールドのバランスが取れる
        // - require-prior-idle-ms: タイピング中は修飾キー発動しない
        // - hold-trigger-on-release: キーを離した時に判定（誤発動防止）

        HRM: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            display-name = "HRM";
        };

        // 通常の修飾キー用（親指・端のキー向け、標準的な反応速度）

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        // マウスレイヤー用: ホールドで修飾キー、タップで言語切り替え+メインレイヤーに戻る

        ht_l2_mac: ht_lang2_mac {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang2_mac>;
        };

        ht_l1_mac: ht_lang1_mac {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang1_mac>;
        };

        ht_l2_win: ht_lang2_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang2_win>;
        };

        ht_l1_win: ht_lang1_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang1_win>;
        };

        ht_l2_ipad: ht_lang2_ipad {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang2_ipad>;
        };

        ht_l1_ipad: ht_lang1_ipad {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&lang1_ipad>;
        };
    };
};

/ {
    macros {
        input_userid: input_userid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8>;
            label = "INPUT_USERID";
        };

        input_email_proton: input_email_proton {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8 &kp AT &kp P &kp R &kp O &kp T &kp O &kp N &kp DOT &kp M &kp E>;
            label = "INPUT_EMAIL_PROTON";
        };

        // BT接続 + ベースレイヤー切り替えマクロ

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to MAIN_MAC>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to MAIN_WIN>;
            label = "BT_WIN";
        };

        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to MAIN_IPAD>;
            label = "BT_IPAD";
        };

        // ゲームモード切り替えマクロ

        to_game: to_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to BASE_GAME>;
            label = "TO_GAME";
        };

        // 言語切り替え + メインレイヤーに戻るマクロ

        lang2_mac: lang2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to MAIN_MAC>;
            label = "LANG2_MAC";
        };

        lang1_mac: lang1_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to MAIN_MAC>;
            label = "LANG1_MAC";
        };

        lang2_win: lang2_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to MAIN_WIN>;
            label = "LANG2_WIN";
        };

        lang1_win: lang1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to MAIN_WIN>;
            label = "LANG1_WIN";
        };

        lang2_ipad: lang2_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to MAIN_IPAD>;
            label = "LANG2_IPAD";
        };

        lang1_ipad: lang1_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to MAIN_IPAD>;
            label = "LANG1_IPAD";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ==================== MAIN LAYERS ====================
        // メインタイピングレイヤー（旧INSERT）
        // ========== Main - Mac (BT0) ==========

        main_mac_layer {
            display-name = "Main-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LG(GRAVE)         &none       &none  &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none        &none  &none      &none    &none                            &none
&kp F19               &kp Q       &kp W  &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y        &kp U  &kp I      &kp O    &kp P                            &mo 9
&kp ESC               &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_GUI) F    &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp H        &kp J  &kp K      &kp L    &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT  &kp Z       &kp X  &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2     &kp C_MUTE         &to 5            &SandS LEFT_SHIFT TAB  &lt 4 SPACE          &mo 3                                                                            &kp BSPC                &lt 4 ENTER                                                              &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ========== Main - Windows (BT1) ==========

        main_win_layer {
            display-name = "Main-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LA(TAB)                &none       &none  &none            &none                    &none                                     &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none        &none  &none      &none    &none                                &none
&kp F19                    &kp Q       &kp W  &kp E            &kp R                    &kp T                                     &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y        &kp U  &kp I      &kp O    &kp P                                &mo 9
&kp ESC                    &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_CONTROL) F  &HRM LEFT_GUI G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp H        &kp J  &kp K      &kp L    &HRM RS(RA(RC(RIGHT_CONTROL))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT       &kp Z       &kp X  &kp C            &kp V                    &kp B            &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH                             &HRM RIGHT_SHIFT RIGHT
&SandS LEFT_CONTROL LANG2  &kp C_MUTE         &to 6            &SandS LEFT_SHIFT TAB    &lt 4 SPACE      &mo 3                                                                            &kp BSPC                &lt 4 ENTER                                                                  &SandS RA(RIGHT_CONTROL) LANG1
            >;
        };

        // ========== Main - iPad (BT2) ==========

        main_ipad_layer {
            display-name = "Main-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LG(GRAVE)         &none       &none  &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none        &none  &none      &none    &none                            &none
&kp F19               &kp Q       &kp W  &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y        &kp U  &kp I      &kp O    &kp P                            &mo 9
&kp ESC               &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_GUI) F    &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp H        &kp J  &kp K      &kp L    &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT  &kp Z       &kp X  &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2     &kp C_MUTE         &to 7            &SandS LEFT_SHIFT TAB  &lt 4 SPACE          &mo 3                                                                            &kp BSPC                &lt 4 ENTER                                                              &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ==================== FUNCTION LAYERS ====================
        // ========== Lower Layer ==========

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans    &trans     &trans
&trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS  &kp PRCNT  &trans
&kp CARET  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5   &trans    &trans  &trans  &trans  &trans    &trans  &kp N6    &kp N7     &kp N8    &kp N9    &kp N0     &trans
&kp PG_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans    &trans  &trans  &trans  &trans    &trans  &kp F11   &kp F12    &trans    &trans    &kp DLLR   &trans
&trans     &trans          &trans  &trans  &trans   &trans                                      &trans  &trans                                              &none
            >;
        };

        // ========== Raise Layer ==========

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans     &trans     &trans     &trans    &trans    &trans               &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans     &trans     &trans
&trans     &kp QMARK  &kp EXCL   &kp AMPS  &kp PIPE  &kp BSLH             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS   &kp PRCNT  &trans
&kp CARET  &kp POUND  &kp GRAVE  &kp DQT   &kp SQT   &kp TILDE  &trans    &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &kp COLON  &trans
&trans     &kp AT     &kp LT     &kp LBRC  &kp LBKT  &kp LPAR   &trans    &trans  &trans  &trans  &trans    &trans  &kp RPAR  &kp RBKT   &kp RBRC  &kp GT     &kp DLLR   &trans
&trans     &trans                &trans    &trans    &trans     &trans                                      &trans  &trans                                               &trans
            >;
        };

        // ==================== MOUSE LAYERS ====================
        // マウス操作レイヤー: HJKL = カーソル移動、Shift+HJKL = 高速移動
        // 親指クラスタ = クリック操作、スクロールモードアクセス
        // ========== Mouse Layer - Mac ==========

        mouse_mac_layer {
            display-name = "Mous-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&trans             &trans  &trans     &trans     &trans     &trans            &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE              &trans          &trans          &trans        &trans           &trans  &trans
&trans             &trans  &trans     &trans     &trans     &trans            &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY            &trans          &trans          &trans        &trans           &trans  &trans
&trans             &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans             &trans  &trans     &mkp MB5   &mkp MB4   &trans  &trans    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &trans  &trans          &mkp MB4        &mkp MB5      &trans           &trans  &trans
&ht_l2_mac LGUI 0  &trans             &trans     &trans     &trans  &mo 8                                                             &trans  &trans                                                                 &ht_l1_mac RA(RIGHT_GUI) 0
            >;
        };

        // ========== Mouse Layer - Windows ==========

        mouse_win_layer {
            display-name = "Mous-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&trans                     &trans  &trans     &trans     &trans     &trans              &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE              &trans          &trans          &trans        &trans           &trans  &trans
&trans                     &trans  &trans     &trans     &trans     &trans              &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY            &trans          &trans          &trans        &trans           &trans  &trans
&trans                     &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans    &trans    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans                     &trans  &trans     &mkp MB5   &mkp MB4   &trans    &trans    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &trans  &trans          &mkp MB4        &mkp MB5      &trans           &trans  &trans
&ht_l2_win LEFT_CONTROL 0  &trans             &trans     &trans     &trans    &mo 8                                                             &trans  &trans                                                                 &ht_l1_win RA(RIGHT_CONTROL) 0
            >;
        };

        // ========== Mouse Layer - iPad ==========

        mouse_ipad_layer {
            display-name = "Mous-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&trans              &trans  &trans     &trans     &trans     &trans              &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE              &trans          &trans          &trans        &trans           &trans  &trans
&trans              &trans  &trans     &trans     &trans     &trans              &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY            &trans          &trans          &trans        &trans           &trans  &trans
&trans              &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans    &trans    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans              &trans  &trans     &mkp MB5   &mkp MB4   &trans    &trans    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &trans  &trans          &mkp MB4        &mkp MB5      &trans           &trans  &trans
&ht_l2_ipad LGUI 0  &trans             &trans     &trans     &trans    &mo 8                                                             &trans  &trans                                                                 &ht_l1_ipad RA(RIGHT_GUI) 0
            >;
        };

        // ========== Scroll Layer (マウスレイヤー内でスクロール操作) ==========

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                                                 &trans
            >;
        };

        // ========== Control Layer (BT/システム) ==========

        control_layer {
            display-name = "Ctrl";
            bindings = <
&trans       &trans         &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans            &trans         &trans               &trans  &trans  &trans  &trans
&kp C_SLEEP  &kp LG(MINUS)  &kp LG(PLUS)  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                    &trans  &trans  &trans  &trans            &trans         &trans               &trans  &trans  &trans  &trans
&trans       &bt_mac        &bt_win       &bt_ipad      &to_game      &bt BT_SEL 4  &bt BT_CLR        &trans  &trans  &trans  &trans    &trans  &trans         &trans               &trans  &trans  &trans  &trans
&trans       &trans         &out OUT_USB  &out OUT_TOG  &out OUT_BLE  &trans        &bt BT_CLR_ALL    &trans  &trans  &trans  &trans    &trans  &input_userid  &input_email_proton  &trans  &trans  &trans  &trans
&trans       &trans                       &trans        &trans        &trans        &trans                                              &trans  &trans                                                      &trans
            >;
        };

        // ========== Game Layer (兼業キーなし) ==========

        base_game_layer {
            display-name = "Game";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp N1                 &kp N2      &kp N3  &kp N4       &kp N5     &kp N6                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none  &none      &none    &none     &none
&kp TAB                &kp Q       &kp W   &kp E        &kp R      &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &kp Y      &kp U  &kp I      &kp O    &kp P     &kp RBKT
&kp ESC                &kp A       &kp S   &kp D        &kp F      &kp G      &kp LEFT_CONTROL    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp RIGHT_SHIFT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp MINUS
&kp LEFT_SHIFT         &kp Z       &kp X   &kp C        &kp V      &kp B      &kp LEFT_ALT        &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP           &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT
&SandS LEFT_GUI LANG2  &kp C_MUTE          &mo CONTROL  &mo RAISE  &kp SPACE  &mo LOWER                                                                   &kp BSPC         &kp ENTER                                       &kp LANG1
            >;
        };

        // Extra layer can be added in ZMK STUDIO
    };
};
