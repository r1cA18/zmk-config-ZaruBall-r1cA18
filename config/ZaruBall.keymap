#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ZMK Studio unlock behavior

&studio_unlock {
};

// レイヤー定義

#define MAIN_MAC     0   // Main - Mac (デフォルト)
#define MAIN_WIN     1   // Main - Windows
#define MAIN_IPAD    2   // Main - iPad
#define LOWER        3   // 数字/記号
#define RAISE        4   // 記号/ナビ
#define MOUSE_MAC    5   // マウス操作 - Mac
#define MOUSE_WIN    6   // マウス操作 - Windows
#define MOUSE_IPAD   7   // マウス操作 - iPad
#define SCROLL       8   // スクロールモード
#define CONTROL      9   // BT/システム
#define BASE_GAME   10   // ゲーム用（兼業キーなし）

// layer-tapの設定（素早く切り替え、離した時に認識）

&lt {
    tapping-term-ms = <200>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&none>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&none>;
        };

        // ホームロウモッド用（高速タイピング中の誤発動防止設定）
        // - balanced: タップとホールドのバランスが取れる
        // - require-prior-idle-ms: タイピング中は修飾キー発動しない
        // - hold-trigger-on-release: キーを離した時に判定（誤発動防止）

        HRM: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            display-name = "HRM";
        };

        // 通常の修飾キー用（親指・端のキー向け、標準的な反応速度）

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        // マウス移動: Shift押下で高速移動（mod-morph）
        mm_left: mouse_move_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_LEFT>, <&mmv_fast MOVE_LEFT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_down: mouse_move_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv_fast MOVE_DOWN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_up: mouse_move_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_UP>, <&mmv_fast MOVE_UP>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_right: mouse_move_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv_fast MOVE_RIGHT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 高速マウス移動（mmvの高速版）
        mmv_fast: mmv_fast {
            compatible = "zmk,behavior-mouse-move";
            #binding-cells = <1>;
            delay-ms = <0>;
            time-to-max-speed-ms = <100>;
            acceleration-exponent = <1>;
        };
    };
};

/ {
    macros {
        input_userid: input_userid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8>;
            label = "INPUT_USERID";
        };

        input_email_proton: input_email_proton {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8 &kp AT &kp P &kp R &kp O &kp T &kp O &kp N &kp DOT &kp M &kp E>;
            label = "INPUT_EMAIL_PROTON";
        };

        // BT接続 + ベースレイヤー切り替えマクロ

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to MAIN_MAC>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to MAIN_WIN>;
            label = "BT_WIN";
        };

        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to MAIN_IPAD>;
            label = "BT_IPAD";
        };

        // ゲームモード切り替えマクロ

        to_game: to_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to BASE_GAME>;
            label = "TO_GAME";
        };

        // マウスレイヤー切り替えマクロ（各プラットフォーム用）

        tog_mouse_mac: tog_mouse_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MOUSE_MAC>;
            label = "TOG_MOUSE_MAC";
        };

        tog_mouse_win: tog_mouse_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MOUSE_WIN>;
            label = "TOG_MOUSE_WIN";
        };

        tog_mouse_ipad: tog_mouse_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MOUSE_IPAD>;
            label = "TOG_MOUSE_IPAD";
        };

        exit_mouse_mac: exit_mouse_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAIN_MAC>;
            label = "EXIT_MOUSE_MAC";
        };

        exit_mouse_win: exit_mouse_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAIN_WIN>;
            label = "EXIT_MOUSE_WIN";
        };

        exit_mouse_ipad: exit_mouse_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAIN_IPAD>;
            label = "EXIT_MOUSE_IPAD";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ==================== MAIN LAYERS ====================
        // メインタイピングレイヤー（旧INSERT）
        // ========== Main - Mac (BT0) ==========

        main_mac_layer {
            display-name = "Main-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp LG(GRAVE)         &none       &none  &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none            &none  &none      &none    &none                            &none
&kp F19               &kp Q       &kp W  &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y            &kp U  &kp I      &kp O    &kp P                            &kp ESC
&tog_mouse_mac        &kp A       &kp S  &HRM LEFT_ALT D  &HRM LS(LEFT_GUI) F    &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &kp H            &kp J  &kp K      &kp L    &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&HRM LEFT_SHIFT LEFT  &kp Z       &kp X  &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N            &kp M  &kp COMMA  &kp DOT  &kp FSLH                         &HRM RIGHT_SHIFT RIGHT
&SandS LGUI LANG2     &kp C_MUTE         &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE      &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                              &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ========== Main - Windows (BT1) ==========

        main_win_layer {
            display-name = "Main-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none              &none       &none                    &none            &none                  &none                                     &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none             &none                 &none             &none                     &none                                &none
&kp F19            &kp Q       &kp W                    &kp E            &kp R                  &kp T                                     &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y             &kp U                 &kp I             &kp O                     &kp P                                &kp ESC
&tog_mouse_win     &kp A       &HRM LS(LEFT_CONTROL) S  &HRM LEFT_ALT D  &HRM LEFT_CONTROL F    &HRM LEFT_GUI G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &HRM RIGHT_GUI H  &HRM RIGHT_CONTROL J  &HRM RIGHT_ALT K  &HRM RS(RIGHT_CONTROL) L  &HRM RS(RA(RC(RIGHT_CONTROL))) SEMI  &kp MINUS
&kp LEFT           &kp Z       &kp X                    &kp C            &kp V                  &kp B            &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N             &kp M                 &kp COMMA         &kp DOT                   &kp FSLH                             &kp RIGHT
&SandS LCTL LANG2  &kp C_MUTE                           &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE  &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                                                                          &SandS RA(RIGHT_CONTROL) LANG1
            >;
        };

        // ========== Main - iPad (BT2) ==========

        main_ipad_layer {
            display-name = "Main-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none               &none       &none                &none            &none                  &none                                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                              &none                 &none             &none             &none                 &none                            &none
&kp F19             &kp Q       &kp W                &kp E            &kp R                  &kp T                                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                            &kp Y                 &kp U             &kp I             &kp O                 &kp P                            &kp ESC
&tog_mouse_ipad     &kp A       &HRM LS(LEFT_GUI) S  &HRM LEFT_ALT D  &HRM LEFT_GUI F        &HRM LEFT_CONTROL G  &SandS LEFT_SHIFT TAB    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &SandS RIGHT_SHIFT TAB  &HRM RIGHT_CONTROL H  &HRM RIGHT_GUI J  &HRM RIGHT_ALT K  &HRM RS(RIGHT_GUI) L  &HRM RS(RA(RC(RIGHT_GUI))) SEMI  &kp MINUS
&kp LEFT            &kp Z       &kp X                &kp C            &kp V                  &kp B                &kp DOWN                 &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP                  &kp N                 &kp M             &kp COMMA         &kp DOT               &kp FSLH                         &kp RIGHT
&SandS LGUI LANG2   &kp C_MUTE                       &mo CONTROL      &SandS LEFT_SHIFT TAB  &lt RAISE SPACE      &mo LOWER                                                                        &kp BSPC                &lt RAISE ENTER                                                                                                  &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        // ==================== FUNCTION LAYERS ====================
        // ========== Lower Layer ==========

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans    &trans     &trans
&trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS  &kp PRCNT  &trans
&kp CARET  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5   &trans    &trans  &trans  &trans  &trans    &trans  &kp N6    &kp N7     &kp N8    &kp N9    &kp N0     &trans
&kp PG_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans    &trans  &trans  &trans  &trans    &trans  &kp F11   &kp F12    &trans    &trans    &kp DLLR   &trans
&trans     &trans          &trans  &trans  &trans   &trans                                      &trans  &trans                                              &none
            >;
        };

        // ========== Raise Layer ==========

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans     &trans     &trans     &trans    &trans    &trans               &trans  &trans  &trans  &trans            &trans    &trans     &trans    &trans     &trans     &trans
&trans     &kp QMARK  &kp EXCL   &kp AMPS  &kp PIPE  &kp BSLH             &trans  &trans  &trans  &trans            &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS   &kp PRCNT  &trans
&kp CARET  &kp POUND  &kp GRAVE  &kp DQT   &kp SQT   &kp TILDE  &trans    &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &kp COLON  &trans
&trans     &kp AT     &kp LT     &kp LBRC  &kp LBKT  &kp LPAR   &trans    &trans  &trans  &trans  &trans    &trans  &kp RPAR  &kp RBKT   &kp RBRC  &kp GT     &kp DLLR   &trans
&trans     &trans                &trans    &trans    &trans     &trans                                      &trans  &trans                                               &trans
            >;
        };

        // ==================== MOUSE LAYERS ====================
        // マウス操作レイヤー: HJKL = カーソル移動、Shift+HJKL = 高速移動
        // 親指クラスタ = クリック操作、スクロールモードアクセス
        // ========== Mouse Layer - Mac ==========

        mouse_mac_layer {
            display-name = "Mous-M";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none            &none     &none     &none     &none     &none                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none                  &none                  &none                   &none      &none
&none            &none     &none     &none     &none     &none                                  &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &none      &none                  &none                  &none                   &none      &kp ESC
&exit_mouse_mac  &none     &none     &none     &none     &none      &none                       &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &none            &mm_left  &mm_down  &mm_up  &mm_right  &none      &none
&none            &none     &none     &none     &none     &none      &none                       &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &none            &none      &none                  &none                  &none                   &none      &none
&kp LGUI         &none                &mo CONTROL  &mkp MCLK    &mkp LCLK    &mo SCROLL                                                                 &mkp RCLK        &mkp LCLK                                                                                 &kp RA(RIGHT_GUI)
            >;
        };

        // ========== Mouse Layer - Windows ==========

        mouse_win_layer {
            display-name = "Mous-W";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none            &none     &none     &none     &none     &none                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none                  &none                  &none                   &none      &none
&none            &none     &none     &none     &none     &none                                  &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &none      &none                  &none                  &none                   &none      &kp ESC
&exit_mouse_win  &none     &none     &none     &none     &none      &none                       &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &none            &mm_left  &mm_down  &mm_up  &mm_right  &none      &none
&none            &none     &none     &none     &none     &none      &none                       &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &none            &none      &none                  &none                  &none                   &none      &none
&kp LCTL         &none                &mo CONTROL  &mkp MCLK    &mkp LCLK    &mo SCROLL                                                                 &mkp RCLK        &mkp LCLK                                                                                 &kp RA(RIGHT_CONTROL)
            >;
        };

        // ========== Mouse Layer - iPad ==========

        mouse_ipad_layer {
            display-name = "Mous-I";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&none             &none     &none     &none     &none     &none                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none                  &none                  &none                   &none      &none
&none             &none     &none     &none     &none     &none                                  &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &none      &none                  &none                  &none                   &none      &kp ESC
&exit_mouse_ipad  &none     &none     &none     &none     &none      &none                       &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &none            &mm_left  &mm_down  &mm_up  &mm_right  &none      &none
&none             &none     &none     &none     &none     &none      &none                       &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &none            &none      &none                  &none                  &none                   &none      &none
&kp LGUI          &none                &mo CONTROL  &mkp MCLK    &mkp LCLK    &mo SCROLL                                                                 &mkp RCLK        &mkp LCLK                                                                                 &kp RA(RIGHT_GUI)
            >;
        };

        // ========== Scroll Layer (マウスレイヤー内でスクロール操作) ==========

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;
        };

        // ========== Control Layer (BT/システム) ==========

        control_layer {
            display-name = "Ctrl";
            bindings = <
&trans       &trans         &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans            &trans         &trans               &trans  &trans  &trans  &trans
&kp C_SLEEP  &kp LG(MINUS)  &kp LG(PLUS)  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                    &trans  &trans  &trans  &trans            &trans         &trans               &trans  &trans  &trans  &trans
&trans       &bt_mac        &bt_win       &bt_ipad      &to_game      &bt BT_SEL 4  &bt BT_CLR        &trans  &trans  &trans  &trans    &trans  &none          &none                &none   &none   &trans  &trans
&trans       &trans         &out OUT_USB  &out OUT_TOG  &out OUT_BLE  &trans        &bt BT_CLR_ALL    &trans  &trans  &trans  &trans    &trans  &input_userid  &input_email_proton  &trans  &trans  &trans  &trans
&trans       &trans                       &trans        &trans        &trans        &trans                                              &trans  &trans                                                      &trans
            >;
        };

        // ========== Game Layer (兼業キーなし) ==========

        base_game_layer {
            display-name = "Game";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&kp N1                 &kp N2      &kp N3  &kp N4       &kp N5     &kp N6                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                       &none      &none  &none      &none    &none     &none
&kp TAB                &kp Q       &kp W   &kp E        &kp R      &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                     &kp Y      &kp U  &kp I      &kp O    &kp P     &kp RBKT
&kp ESC                &kp A       &kp S   &kp D        &kp F      &kp G      &kp LEFT_CONTROL    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp RIGHT_SHIFT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp MINUS
&kp LEFT_SHIFT         &kp Z       &kp X   &kp C        &kp V      &kp B      &kp LEFT_ALT        &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp UP           &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT
&SandS LEFT_GUI LANG2  &kp C_MUTE          &mo CONTROL  &mo RAISE  &kp SPACE  &mo LOWER                                                                   &kp BSPC         &kp ENTER                                       &kp LANG1
            >;
        };

        // Extra layer can be added in ZMK STUDIO
    };
};
