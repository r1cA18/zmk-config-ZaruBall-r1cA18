if SHIELD_ZARUBALL_RIGHT #ここを変えてセントラル側に問題のコードを移行

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "ZaruBall"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ZARUBALL_LEFT || SHIELD_ZARUBALL_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_ZARUBALL_LEFT

config EC11
    default y

config EC11_TRIGGER_GLOBAL_THREAD
    default y

endif

# Input Device(pmw3610)のためのコンフィグ
if SHIELD_ZARUBALL_RIGHT

# Other settings

config INPUT
    default y

config ZMK_POINTING
    default y

# Assuming pointing device uses SPI
config SPI
    default y

config PMW3610_ALT
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif
